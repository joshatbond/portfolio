---
/**
 * 404 (Figma 2076:2029 desktop, 2076:2424 mobile): the pool as a static
 * still, with no sim or input. "404" sits deep in the water where the name
 * usually is, and one Bun chip sinks.
 */
import { Image } from 'astro:assets'
import PoolLayout from '../layouts/PoolLayout.astro'
import Button from '../components/Button.astro'
import bunChip from '../assets/pool/bun-chip.png'
---

<PoolLayout title="Page not found" description="This page sank without a trace." index={false}>
  <div class="abyss">
    <Image src={bunChip} alt="" width={68} class="sinking-chip" loading="eager" />
    <h1 class="code">404 <span class="visually-hidden">Page not found</span></h1>
    <p class="sub">
      <span class="wide-only">Nothing down here but the deep end</span>
      <span class="narrow-only">Nothing down here</span>
    </p>
  </div>
  <p class="message">This page sank without a trace. The link may be old, or it never existed.</p>
  <div class="pills">
    <Button href="/" size="pill" icon="arrow-up">Back to the surface</Button>
    <Button href="/projects" size="pill" tone="outline" icon="arrow-right">Projects</Button>
  </div>
</PoolLayout>

<style>
  .abyss {
    /* Text in the water: pressing around shouldn't select it. */
    user-select: none;
    -webkit-user-select: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    color: color-mix(in srgb, var(--pool-paint) 56%, var(--pool-shallow));
  }

  .code {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 100px;
    line-height: 92px;
    letter-spacing: -0.035em;
    /* A wide, faint halo: anything brighter crowds the letters below the
       contrast floor. */
    text-shadow: 0 0 36px rgb(6 182 212 / 0.16);
  }

  .sub {
    font: 500 13.5px/18px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 0 11px rgb(6 182 212 / 0.45);
  }

  .message {
    max-width: 320px;
    margin-top: 48px;
    color: var(--text-secondary);
    font: 400 16px/26px var(--font-body);
    letter-spacing: -0.002em;
  }

  .pills {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: 22px;
  }

  /* Mid-water: small, dimmed by depth, drifting down above the heading
     (anchored to it, so it never sits behind the glyphs). */
  .abyss {
    position: relative;
  }

  :global(.sinking-chip) {
    position: absolute;
    bottom: calc(100% + 30px);
    left: 62%;
    width: 46px;
    height: auto;
    opacity: 0.85;
    filter: brightness(0.8) saturate(0.85);
    transform: rotate(-14deg);
    pointer-events: none;
  }

  @media (min-width: 720px) {
    .code {
      font-size: 138px;
      line-height: 128px;
    }

    .sub {
      font-size: 16px;
      line-height: 20px;
      letter-spacing: 0.14em;
    }

    .message {
      max-width: 640px;
      margin-top: 50px;
      font-size: 20px;
      line-height: 32px;
      letter-spacing: -0.005em;
    }

    .pills {
      flex-direction: row;
      gap: var(--space-6);
      margin-top: 28px;
    }

  }
</style>
