---
/**
 * Homepage (Figma 2017:1046 desktop, 2023:1656 mobile). This is the DOM layer:
 * it paints first over the still pool, stays readable without JS, and keeps
 * the keyboard order h1 → Resume → Projects → HUD. The WebGL scene fades in
 * behind it where it can run (src/scene).
 */
import PoolLayout from '../layouts/PoolLayout.astro'
import Button from '../components/Button.astro'
import { site } from '../config/site'

const [first, ...rest] = site.name.split(' ')
---

<PoolLayout status hint>
  <div slot="scene" class="pool-scene"></div>
  <div class="abyss">
    <h1 class="name">
      <span>{first}</span>{' '}<span>{rest.join(' ')}</span>
    </h1>
    <p class="role">
      <span class="wide-only">{site.title}</span>
      <span class="narrow-only">{site.titleShort}</span>
    </p>
  </div>
  <div class="pills">
    <Button href={site.links.resume} size="pill" icon="arrow-right" label="Resume (PDF)">Resume</Button>
    <Button href="/projects" size="pill" tone="outline" icon="arrow-right">Projects</Button>
  </div>
</PoolLayout>

<script>
  // The water scene: loaded after first paint, and only where it can run well.
  // Otherwise the still pool stays (no WebGL2, Save-Data, low-power devices).
  const el = document.querySelector<HTMLElement>('.pool-scene')
  const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number }
  const saveData = nav.connection?.saveData || matchMedia('(prefers-reduced-data: reduce)').matches
  const lowPower = (nav.deviceMemory ?? 8) < 4 || (nav.hardwareConcurrency ?? 8) < 4
  const canRun = () => {
    const gl = document.createElement('canvas').getContext('webgl2')
    const ok = Boolean(gl && (gl.getExtension('EXT_color_buffer_half_float') || gl.getExtension('EXT_color_buffer_float')))
    gl?.getExtension('WEBGL_lose_context')?.loseContext()
    return ok
  }
  if (el && !saveData && !lowPower && canRun()) {
    await document.fonts.ready
    const { mountScene } = await import('../scene')
    // Reduced motion: the Still frame, rendered once.
    mountScene(el, { motion: !matchMedia('(prefers-reduced-motion: reduce)').matches })
  }
</script>

<style is:global>
  .pool-scene {
    position: absolute;
    inset: 0;
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  html[data-scene='ready'] .pool-scene {
    opacity: 1;
  }

  /* Once the scene draws the name and title in the water, the DOM copy stays
     for screen readers but stops painting. */
  html[data-scene='ready'] .abyss .name,
  html[data-scene='ready'] .abyss .role {
    color: transparent;
    text-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .pool-scene {
      transition: none;
    }
  }
</style>

<style>
  /* The name and title hang deep in the water, softly lit (Figma "Abyss"
     layer, seen through the haze): pool/paint at about half strength, just
     bright enough to hold the 4.57:1 floor where the rim light reaches it. */
  .abyss {
    /* Text in the water: pressing around shouldn't select it. */
    user-select: none;
    -webkit-user-select: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    color: color-mix(in srgb, var(--pool-paint) 56%, var(--pool-shallow));
  }

  .name {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 55px;
    line-height: 51px;
    letter-spacing: -0.035em;
    /* A wide, faint halo: anything brighter crowds the letters below the
       contrast floor. */
    text-shadow: 0 0 36px rgb(6 182 212 / 0.16);
  }

  .role {
    font: 500 13.5px/18px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 0 11px rgb(6 182 212 / 0.45);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 104px;
  }

  @media (min-width: 720px) {
    .name {
      flex-direction: row;
      gap: 0.25em;
      font-size: 75px;
      line-height: 72px;
    }

    .role {
      font-size: 16px;
      line-height: 20px;
      letter-spacing: 0.14em;
    }

    .pills {
      gap: var(--space-6);
      margin-top: 106px;
    }
  }
</style>
