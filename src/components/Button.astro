---
/**
 * Link styled as a button (Figma "Button" set 2042:633) or a pill (Figma
 * "Pill float" set 2007:380). Filled = cyan gradient with dark ink; Outline =
 * cyan label on a dark glass plate. Both keep labels at 7:1 or better in every
 * state. External links open in a new tab and say so to screen readers.
 */
import Icon, { type IconName } from './Icon.astro'

interface Props {
  href: string
  tone?: 'filled' | 'outline'
  size?: 'button' | 'pill'
  icon?: IconName
  external?: boolean
  /** Replaces the visible label as the accessible name, e.g. "Resume (PDF)". */
  label?: string
  class?: string
  [key: `data-${string}`]: string | undefined
}

const { href, tone = 'filled', size = 'button', icon, external = false, label, class: className, ...rest } = Astro.props
const iconSize = size === 'pill' ? 22 : 16
---

<a
  href={href}
  class:list={['btn', `btn--${tone}`, `btn--${size}`, className]}
  aria-label={label ? (external ? `${label} (opens in a new tab)` : label) : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  {...rest}
>
  <span class="btn__label"><slot /></span>
  {external && !label && <span class="visually-hidden"> (opens in a new tab)</span>}
  {icon && <Icon name={icon} size={iconSize} class="btn__icon" />}
</a>

<style>
  .btn {
    --btn-fill: none;
    --btn-stroke: none;
    --btn-stroke-width: 1.25px;
    --btn-shadow: none;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 12px 18px 12px 22px;
    border-radius: var(--radius-full);
    background: var(--btn-fill);
    box-shadow: var(--btn-shadow);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    line-height: 20px;
    letter-spacing: -0.002em;
    white-space: nowrap;
    transition:
      transform 160ms ease,
      box-shadow 200ms ease,
      background 200ms ease,
      color 200ms ease;
  }

  /* Gradient strokes drawn inside the edge, like Figma's INSIDE stroke. */
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    padding: var(--btn-stroke-width);
    border-radius: inherit;
    background: var(--btn-stroke);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    pointer-events: none;
  }

  .btn__icon {
    flex: none;
  }

  /* ----- Filled ----- */
  .btn--filled {
    --btn-fill: var(--fill-cyan);
    --btn-stroke: var(--stroke-sheen);
    --btn-shadow: inset 0 -2px 5px rgb(14 116 144 / 0.45), 0 0 20px rgb(6 182 212 / 0.25);
    color: var(--text-on-accent);
  }

  .btn--filled:hover,
  .btn--filled:focus-visible {
    --btn-fill: var(--fill-cyan-hover);
    --btn-shadow: inset 0 -2px 5px rgb(14 116 144 / 0.45), 0 8px 20px -4px rgb(0 0 0 / 0.55), 0 0 28px 1px rgb(6 182 212 / 0.55);
  }

  /* ----- Outline ----- */
  .btn--outline {
    --btn-fill: linear-gradient(rgb(6 182 212 / 0.08), rgb(6 182 212 / 0.08)), var(--plate-glass);
    --btn-stroke: var(--stroke-cyan);
    color: var(--text-accent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  .btn--outline:hover,
  .btn--outline:focus-visible {
    --btn-fill: linear-gradient(rgb(34 211 238 / 0.16), rgb(34 211 238 / 0.16)), var(--plate-glass);
    --btn-stroke: var(--stroke-cyan-hover);
    --btn-shadow: inset 0 0 14px rgb(6 182 212 / 0.4), 0 0 26px rgb(6 182 212 / 0.45);
    color: var(--pool-paint);
  }

  /* ----- Pill (homepage and 404 floats) ----- */
  .btn--pill {
    --btn-stroke-width: 1.5px;
    gap: 9px;
    padding: 17px 20px 17px 24px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18.25px;
    line-height: 23px;
    letter-spacing: -0.01em;
  }

  .btn--pill.btn--filled {
    --btn-stroke: linear-gradient(180deg, rgb(255 255 255 / 0.7) 0%, rgb(255 255 255 / 0.06) 45%, rgb(255 255 255 / 0) 100%);
    --btn-shadow: inset 0 -3px 6px rgb(14 116 144 / 0.45), 0 14px 26px -6px rgb(0 0 0 / 0.55), 0 0 24px rgb(6 182 212 / 0.22);
  }

  .btn--pill.btn--filled:hover,
  .btn--pill.btn--filled:focus-visible {
    --btn-shadow: inset 0 -3px 6px rgb(14 116 144 / 0.45), 0 22px 34px -6px rgb(0 0 0 / 0.55), 0 0 40px 2px rgb(6 182 212 / 0.6);
  }

  .btn--pill.btn--outline {
    --btn-shadow: inset 0 0 14px rgb(6 182 212 / 0.22), 0 14px 26px -6px rgb(0 0 0 / 0.5);
  }

  .btn--pill.btn--outline:hover,
  .btn--pill.btn--outline:focus-visible {
    --btn-shadow: inset 0 0 14px rgb(6 182 212 / 0.4), 0 22px 34px -6px rgb(0 0 0 / 0.5), 0 0 36px rgb(6 182 212 / 0.5);
  }

  .btn--pill:hover,
  .btn--pill:focus-visible {
    transform: translateY(-3px);
  }

  .btn--pill:active {
    transform: translateY(1px) scale(0.98);
  }

  @media (min-width: 720px) {
    .btn--pill {
      gap: var(--space-3);
      padding: 23px 26px 23px 32px;
      font-size: 24px;
      line-height: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }

    .btn--pill:hover,
    .btn--pill:focus-visible,
    .btn--pill:active {
      transform: none;
    }
  }
</style>
