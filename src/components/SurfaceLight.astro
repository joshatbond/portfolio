---
/**
 * The inner-page "surface light" band: cyan caustics (tiled at 50% scale,
 * ~8% opacity, screen blend) over pool/deep, a fade to #000204 going down the
 * band, and a soft cyan radial glow under the nav. It's a decorative layer;
 * PageLayout places it across the nav and page-header rows.
 */
import { causticsUrl } from '../lib/caustics'

interface Props {
  /** Caustics opacity (Figma uses 0.07–0.08). */
  opacity?: number
  /** Radial glow: centre y and radius as a fraction of the band, from the frame's gradient handles. */
  glow?: { y: string; rx: string; ry: string; alpha: number }
  class?: string
}

const { opacity = 0.08, glow = { y: '0%', rx: '70%', ry: '60%', alpha: 0.2 }, class: className } = Astro.props
const style = [
  `--caustics: url(${await causticsUrl()})`,
  `--caustics-opacity: ${opacity}`,
  `--glow: radial-gradient(${glow.rx} ${glow.ry} at 50% ${glow.y}, rgb(6 182 212 / ${glow.alpha}), rgb(6 182 212 / 0))`,
].join(';')
---

<div class:list={['surface-light', className]} style={style} aria-hidden="true"></div>

<style>
  .surface-light {
    position: relative;
    isolation: isolate;
    pointer-events: none;
  }

  .surface-light::before,
  .surface-light::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .surface-light::before {
    background: var(--caustics) 0 0 / 512px 512px repeat;
    opacity: var(--caustics-opacity);
    mix-blend-mode: screen;
  }

  .surface-light::after {
    background:
      var(--glow),
      linear-gradient(180deg, rgb(0 2 4 / 0) 0%, var(--pool-deep) 100%);
  }
</style>
