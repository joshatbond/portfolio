---
/**
 * The pool as a static still, in CSS. The viewport is a window looking out
 * into the inky deep: a lamp behind the camera throws a soft glow into the
 * water, and specks drift through it.
 *
 * It's the first paint, and what the WebGL scene fades in over. On top of the
 * CSS light sits a pre-rendered still of the scene itself
 * (scripts/render-pool-still.mjs), which is all that shows where the scene
 * can't run: no WebGL, Save-Data, low-power devices.
 *
 * On the homepage the still shows the stack chips, except where the scene
 * will run with motion (html[data-scene], set in the page's <head>): there
 * the chips swim in from off camera as the scene starts, so it paints empty
 * water first.
 */
import { getImage } from 'astro:assets'
import desktopChips from '../assets/pool/still-desktop.webp'
import mobileChips from '../assets/pool/still-mobile.webp'
import desktopEmpty from '../assets/pool/still-empty-desktop.webp'
import mobileEmpty from '../assets/pool/still-empty-mobile.webp'

interface Props {
  /** The stack chips at the surface (homepage) or empty water (404). */
  variant?: 'chips' | 'empty'
}

const { variant = 'chips' } = Astro.props
const stills = { chips: [desktopChips, mobileChips], empty: [desktopEmpty, mobileEmpty] }
const [desktop, mobile, emptyDesktop, emptyMobile] = await Promise.all(
  [...stills[variant], ...stills.empty].map((src) => getImage({ src, format: 'webp' })),
)
// Backgrounds rather than an <img>, so only the still that shows is fetched.
const still = `--still: url(${desktop.src}); --still-mobile: url(${mobile.src}); --still-empty: url(${emptyDesktop.src}); --still-empty-mobile: url(${emptyMobile.src})`

// Motes drifting in the mid-water: a fixed scatter.
let seed = 20261127
const rand = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296)
const motes = Array.from({ length: 36 }, () => {
  const x = (8 + rand() * 84).toFixed(2)
  const y = (8 + rand() * 84).toFixed(2)
  const a = (0.1 + rand() * 0.2).toFixed(2)
  const r = rand() < 0.2 ? 1.5 : 1
  return `radial-gradient(${r}px ${r}px at ${x}% ${y}%, rgb(207 250 254 / ${a}), transparent)`
}).join(',')
---

<div class="tub" style={`--motes: ${motes}; ${still}`} aria-hidden="true">
  <div class="light"></div>
  <div class="render"></div>
  <div class="motes"></div>
  <slot />
  <div class="vignette"></div>
</div>

<style>
  /* The deep is the page's own colour (on <html>), so the light can sit
     below the stacking order (see .light). */
  .tub {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .tub > * {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* The lamp's light in the inky water: one soft glow, a quarter of the way
     up from the bottom, where the scene's lamp sits behind the camera
     (src/scene/config.ts). */
  /* It sits under everything, so the pages can thicken the water around
     their deep text (PoolLayout's pocket) between it and the still. */
  .light {
    z-index: -2;
    background: radial-gradient(60vmax 48vmax at 50% 75%, rgb(6 182 212 / 0.22), rgb(6 182 212 / 0.06) 50%, transparent);
  }

  .render {
    background: center / cover no-repeat var(--still);
  }

  @media (max-width: 719.98px) {
    .render {
      background-image: var(--still-mobile);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root[data-scene]) .render {
      --still: var(--still-empty);
      --still-mobile: var(--still-empty-mobile);
    }
  }

  .motes {
    background: var(--motes);
  }

  .vignette {
    background: radial-gradient(farthest-corner, rgb(0 0 0 / 0) 55%, rgb(0 0 0 / 0.35));
  }
</style>
