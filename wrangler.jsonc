// The site is a static bundle (dist/) served by Cloudflare Workers static
// assets: no Worker code runs. Deploy with `pnpm run deploy`.
{
  "name": "portfolio",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "joshuarichardson.me", "custom_domain": true },
    { "pattern": "www.joshuarichardson.me", "custom_domain": true },
  ],
  "workers_dev": false,
}
